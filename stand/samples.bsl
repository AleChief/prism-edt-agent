// Образцы типовых приёмов встроенного языка 1С и языка запросов (как в модулях живой конфигурации).
// Имена объектов метаданных здесь условные — в своей задаче бери имена из проекта.

#Область ТаблицаЗначений

Функция ПримерТаблицыЗначений()
	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Номенклатура");
	Таблица.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число"));
	НоваяСтрока = Таблица.Добавить();
	НоваяСтрока.Количество = 5;
	Таблица.Свернуть("Номенклатура", "Количество");          // группировка с суммированием
	Таблица.Сортировать("Количество Убыв");
	Найденная = Таблица.Найти(5, "Количество");              // строка или Неопределено
	Итог = Таблица.Итог("Количество");
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		Итог = Итог + СтрокаТаблицы.Количество;
	КонецЦикла;
	Возврат Таблица;
КонецФункции

#КонецОбласти

#Область Запросы

Функция ПримерЗапросаСВыборкой(Склад, МассивНоменклатуры)
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Остатки.Номенклатура КАК Номенклатура,
	|	ЕСТЬNULL(Остатки.КоличествоОстаток, 0) КАК Остаток
	|ИЗ
	|	РегистрНакопления.ТоварыНаСкладах.Остатки(&Дата, Склад = &Склад И Номенклатура В (&Список)) КАК Остатки";
	// У виртуальной таблицы остатков поле ресурса называется <Ресурс>Остаток,
	// у оборотов — <Ресурс>Оборот (для регистра остатков: <Ресурс>Приход, <Ресурс>Расход),
	// у ОстаткиИОбороты — <Ресурс>НачальныйОстаток, <Ресурс>Приход, <Ресурс>Расход, <Ресурс>КонечныйОстаток.
	// Условия отбора пишутся в параметрах виртуальной таблицы по именам измерений без псевдонима.
	Запрос.УстановитьПараметр("Дата", ТекущаяДатаСеанса());
	Запрос.УстановитьПараметр("Склад", Склад);
	Запрос.УстановитьПараметр("Список", МассивНоменклатуры);
	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		Возврат Новый ТаблицаЗначений;
	КонецЕсли;
	Выборка = Результат.Выбрать();
	Пока Выборка.Следующий() Цикл                              // обход — у выборки, не у результата
		Остаток = Выборка.Остаток;
	КонецЦикла;
	Возврат Результат.Выгрузить();                            // таблица значений
КонецФункции

Функция ПримерыТекстовЗапросов()
	// Группировка и условие по иерархии справочника (группа и все подгруппы):
	Текст1 =
	"ВЫБРАТЬ
	|	Продажи.Номенклатура КАК Номенклатура,
	|	СУММА(Продажи.Сумма) КАК Сумма
	|ИЗ
	|	РегистрНакопления.Продажи КАК Продажи
	|ГДЕ
	|	Продажи.Период МЕЖДУ &Начало И &Конец
	|	И Продажи.Номенклатура В ИЕРАРХИИ (&Группа)
	|СГРУППИРОВАТЬ ПО
	|	Продажи.Номенклатура
	|УПОРЯДОЧИТЬ ПО
	|	Сумма УБЫВ";
	// Обороты регистра накопления за период:
	Текст2 = "ВЫБРАТЬ Обороты.Номенклатура, Обороты.КоличествоОборот ИЗ РегистрНакопления.Продажи.Обороты(&Начало, &Конец, , Склад = &Склад) КАК Обороты";
	// Последнее значение периодического регистра сведений на дату:
	Текст3 = "ВЫБРАТЬ Цены.Цена ИЗ РегистрСведений.Цены.СрезПоследних(&Дата, Номенклатура = &Номенклатура) КАК Цены";
	// Остатки регистра бухгалтерии по счёту; обороты с субконто — в таблице ДвиженияССубконто:
	Текст4 = "ВЫБРАТЬ Остатки.СуммаОстатокДт, Остатки.СуммаОстатокКт ИЗ РегистрБухгалтерии.Хозрасчетный.Остатки(&Дата, Счет = &Счет) КАК Остатки";
	// Элементы справочника: подчинение владельцу и признак группы
	Текст5 = "ВЫБРАТЬ Договоры.Ссылка ИЗ Справочник.Договоры КАК Договоры ГДЕ Договоры.Владелец = &Контрагент И НЕ Договоры.ПометкаУдаления";
	Возврат Текст1;
КонецФункции

#КонецОбласти

#Область Прочее

Процедура ПримерыПрочего(ДокументОбъект, Счет)
	Ставка = Константы.СтавкаНДС.Получить();                    // значение константы
	ЭтоАктивный = (Счет.Вид = ВидСчета.Активный);              // вид счёта плана счетов
	Для Каждого СтрокаТЧ Из ДокументОбъект.Товары Цикл          // табличная часть объекта
		СтрокаТЧ.Сумма = Окр(СтрокаТЧ.Цена * СтрокаТЧ.Количество, 2);
	КонецЦикла;
	Соответствие = Новый Соответствие;
	Соответствие.Вставить("Ключ", 1);
	Значение = Соответствие.Получить("Ключ");                   // Неопределено, если ключа нет
	Массив = Новый Массив;
	Массив.Добавить(1);
	Если Массив.Найти(1) = Неопределено Тогда
		ВызватьИсключение "Не найдено: " + Строка(Счет);
	КонецЕсли;
	Дата1 = НачалоДня(ТекущаяДатаСеанса());
	Дата2 = КонецМесяца(Дата1);
	ПустаяСсылка = Справочники.Склады.ПустаяСсылка();
	Заполнено = ЗначениеЗаполнено(ПустаяСсылка);
КонецПроцедуры

#КонецОбласти
